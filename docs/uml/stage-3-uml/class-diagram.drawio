              <mxPoint x="1405" y="1901.5" />
              <mxPoint x="1405" y="1845.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TM_HH_t" parent="1" style="html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=12;fontColor=#253342;align=center;verticalAlign=middle;" value="1" vertex="1">
          <mxGeometry height="22" width="24" x="690" y="1775.8" as="geometry" />
        </mxCell>
        <mxCell id="W_HH_h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=12;fontColor=#253342;align=center;verticalAlign=middle;" value="1  {shared}" vertex="1">
          <mxGeometry height="22" width="90" x="1360" y="1821.0" as="geometry" />
        </mxCell>
        <mxCell id="note_encapsulation" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;Every field is private, most are final, and there are no public setters. State only changes through methods that check the rules first, e.g. &lt;i&gt;Order.prepareOneUnit()&lt;/i&gt;, &lt;i&gt;Customer.markServed()&lt;/i&gt;, &lt;i&gt;HappyHour.activate()&lt;/i&gt; (once per game). &lt;i&gt;Restaurant&lt;/i&gt; hands out &lt;i&gt;List.copyOf(...)&lt;/i&gt; views, and &lt;i&gt;GameSnapshot&lt;/i&gt;, &lt;i&gt;CustomerView&lt;/i&gt; and &lt;i&gt;TableView&lt;/i&gt; are immutable records, so the CLI can't change game state." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#FFF9C4;strokeColor=#C9B037;fontFamily=Arial;fontSize=13;fontColor=#253342;" vertex="1" parent="1">
          <mxGeometry x="110" y="2206" width="1320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note_polymorphism" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;&lt;i&gt;Customer.applyWaitingLoss()&lt;/i&gt; calls the overridden &lt;i&gt;waitingLossPerTurn()&lt;/i&gt;. &lt;i&gt;Waiter&lt;/i&gt; calls &lt;i&gt;chooseMenuItem()&lt;/i&gt; and &lt;i&gt;quotePriceCents()&lt;/i&gt; through &lt;i&gt;Customer&lt;/i&gt;; &lt;i&gt;CustomerView&lt;/i&gt; calls &lt;i&gt;typeLabel()&lt;/i&gt;. &lt;i&gt;RegularCustomer&lt;/i&gt;, &lt;i&gt;VIPCustomer&lt;/i&gt; and &lt;i&gt;CriticCustomer&lt;/i&gt; supply those rules. &lt;i&gt;ComboMeal&lt;/i&gt; is a &lt;i&gt;MenuItem&lt;/i&gt;, so Order, Chef and pricing handle it without concrete-type checks." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#FFF9C4;strokeColor=#C9B037;fontFamily=Arial;fontSize=13;fontColor=#253342;" vertex="1" parent="1">
          <mxGeometry x="1490" y="2206" width="1320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note_composition" value="&lt;b&gt;Composition and associations&lt;/b&gt;&lt;br&gt;&lt;i&gt;Restaurant&lt;/i&gt; creates and owns its 2 &lt;i&gt;Tables&lt;/i&gt; and 4 &lt;i&gt;MenuItems&lt;/i&gt; (filled diamonds). &lt;i&gt;GameSnapshot&lt;/i&gt; stores immutable &lt;i&gt;CustomerView&lt;/i&gt; and &lt;i&gt;TableView&lt;/i&gt; values. &lt;i&gt;ComboMeal&lt;/i&gt; references the existing Salad and Pasta also held by the menu; those component links are ordinary associations. One &lt;i&gt;HappyHour&lt;/i&gt; is shared by &lt;i&gt;TurnManager&lt;/i&gt; and &lt;i&gt;Waiter&lt;/i&gt;, so those links are associations too." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#FFF9C4;strokeColor=#C9B037;fontFamily=Arial;fontSize=13;fontColor=#253342;" vertex="1" parent="1">
          <mxGeometry x="2870" y="2206" width="1320" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
