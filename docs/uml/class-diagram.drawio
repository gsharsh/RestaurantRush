        <mxCell id="e123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;endArrow=block;endFill=0;endSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c_RegularCustomer" target="c_Customer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note124" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;All fields are private; state changes only through lifecycle methods that enforce the rules (e.g. Order.prepareOneUnit(), Customer.markServed()). No public setters. Collection getters return List.copyOf(...), and GameSnapshot / CustomerView / TableView are immutable records, so the CLI can never change game state." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2013" y="1642" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ne125" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#c9b037;" edge="1" parent="1" source="note124" target="c_Restaurant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note126" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;Restaurant, Table, Waiter and TurnManager depend only on the abstract Customer. Customer's final lifecycle methods call the abstract rules waitingLossPerTurn(), chooseMenuItem() and quotePriceCents(); RegularCustomer supplies the Stage 1 rules (8 points, menu cycle, full price). No code branches on the concrete customer type." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2433" y="1642" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ne127" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#c9b037;" edge="1" parent="1" source="note126" target="c_Customer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note128" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;Restaurant creates and owns its 2 Tables and 3 MenuItems for its whole lifetime. GameSnapshot owns copies of its CustomerViews and TableViews. Customers and Orders are aggregated: they are created elsewhere (ArrivalSchedule, Waiter) and kept as history." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2853" y="1642" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ne129" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#c9b037;" edge="1" parent="1" source="note128" target="c_Table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>